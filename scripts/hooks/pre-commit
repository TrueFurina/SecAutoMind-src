#!/bin/sh
# 提交闸口的答案明文拦截。
#
# 为什么钩子必须存在：脱敏门禁只扫「git 已跟踪的文件」，而工作树里还有未跟踪文件带着
# 答案明文（2026-11-08 实测：96 个文件 / 795 处）。这些文件门禁全都不看，一条
# `git add -A` 就会把它们变成永久公开历史——历史推上去就撤不回来。唯一还来得及拦住
# 的时刻就是 commit 之前。
#
# 只拦「新增行里的已知答案」，不拦已登记在 plaintext_debt.json 里的存量，
# 因此不会让正常提交（含修改已有文件）无故失败。
HOOK_DIR=$(dirname "$0")
export PYTHONIOENCODING=utf-8
CASE_PY="/c/Users/Lenovo/.workbuddy/binaries/python/envs/default/Scripts/python.exe"
if [ -n "$PYTHON" ]; then
  PY="$PYTHON"
elif [ -x "$CASE_PY" ]; then
  PY="$CASE_PY"
else
  PY=python
fi
exec "$PY" -X utf8 "$HOOK_DIR/../../scripts/check_redaction_consistency.py" --staged

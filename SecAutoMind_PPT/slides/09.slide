<Slide style={{ width: '1280px', height: '720px', padding: 40, background: '#0B1120', color: '#F1F5F9', fontFamily: '思源黑体, sans-serif' }}>
  <Box style={{ height: 80, justifyContent: 'center' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0EA5E9' }}>人机协同：敏感操作 HITL 与可审计轨迹</Text>
  </Box>
  <Box style={{ height: 560, flexDirection: 'row', gap: 32 }}>
    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 18, padding: 24, background: 'rgba(14,165,233,0.06)', borderRadius: 16 }}>
      <Text style={{ fontSize: 24, fontWeight: 700, color: '#F1F5F9' }}>HITL 审批</Text>
      <Text style={{ fontSize: 18, color: '#94A3B8', lineHeight: 1.6 }}>高危操作（如漏洞利用、命令执行、数据外带）在执行前自动触发人工审批节点，确保人在回路。</Text>
      <svg width={520} height={260} viewBox='0 0 520 260'>
        <defs>
          <linearGradient id='hitlGrad' x1='0%' y1='0%' x2='0%' y2='100%'>
            <stop offset='0%' stopColor='rgba(59,130,246,0.35)' />
            <stop offset='100%' stopColor='rgba(14,165,233,0.12)' />
          </linearGradient>
          <marker id='arrHitl' markerWidth='10' markerHeight='10' refX='9' refY='3' orient='auto' markerUnits='strokeWidth'>
            <path d='M0,0 L0,6 L9,3 z' fill='#22D3EE' />
          </marker>
        </defs>
        <rect x={160} y={20} width={200} height={50} rx={8} fill='url(#hitlGrad)' stroke='#0EA5E9' strokeWidth={2} />
        <text x={260} y={50} textAnchor='middle' fill='#F1F5F9' fontSize={16} fontWeight='bold' fontFamily='思源黑体, sans-serif'>识别高危操作</text>
        <line x1={260} y1={70} x2={260} y2={110} stroke='#22D3EE' strokeWidth={2} markerEnd='url(#arrHitl)' />
        <rect x={140} y={120} width={240} height={60} rx={8} fill='url(#hitlGrad)' stroke='#22D3EE' strokeWidth={2} />
        <text x={260} y={148} textAnchor='middle' fill='#F1F5F9' fontSize={16} fontWeight='bold' fontFamily='思源黑体, sans-serif'>人工审批</text>
        <text x={260} y={168} textAnchor='middle' fill='#94A3B8' fontSize={13} fontFamily='思源黑体, sans-serif'>同意 / 拒绝 / 修改参数</text>
        <line x1={260} y1={180} x2={260} y2={220} stroke='#22D3EE' strokeWidth={2} markerEnd='url(#arrHitl)' />
        <rect x={160} y={230} width={200} height={50} rx={8} fill='url(#hitlGrad)' stroke='#0EA5E9' strokeWidth={2} />
        <text x={260} y={260} textAnchor='middle' fill='#F1F5F9' fontSize={16} fontWeight='bold' fontFamily='思源黑体, sans-serif'>执行并记录</text>
      </svg>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 18, padding: 24, background: 'rgba(59,130,246,0.06)', borderRadius: 16 }}>
      <Text style={{ fontSize: 24, fontWeight: 700, color: '#F1F5F9' }}>审计轨迹</Text>
      <Text style={{ fontSize: 18, color: '#94A3B8', lineHeight: 1.6 }}>每一次 Agent 决策、工具调用、人工审批都被写入结构化日志，形成可回放、可追责的完整证据链。</Text>
      <Box style={{ flexDirection: 'column', gap: 12 }}>
        {[
          { label: '时间戳', desc: '精确到毫秒的操作时间' },
          { label: '操作者', desc: 'Agent / 用户 / 审批人身份' },
          { label: '输入输出', desc: '工具参数与执行结果快照' },
          { label: '决策链路', desc: '为什么执行、依据哪条策略' },
        ].map((item, idx) => (
          <Box key={idx} style={{ flexDirection: 'row', gap: 12, padding: 12, background: 'rgba(11,17,32,0.5)', borderRadius: 8 }}>
            <Box style={{ width: 8, height: 8, minWidth: 8, borderRadius: 4, background: '#3B82F6', marginTop: 6 }} />
            <Box>
              <Text style={{ fontSize: 17, fontWeight: 700, color: '#F1F5F9', marginBottom: 2 }}>{item.label}</Text>
              <Text style={{ fontSize: 15, color: '#94A3B8' }}>{item.desc}</Text>
            </Box>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 40, justifyContent: 'flex-end', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>09 / 15</Text>
  </Box>
</Slide>

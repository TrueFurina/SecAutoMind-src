          <Box>
            <Text style={{ fontSize: 26, fontWeight: 700, color: '#F1F5F9', marginBottom: 8 }}>{item.title}</Text>
            <Text style={{ fontSize: 20, color: '#94A3B8', lineHeight: 1.5 }}>{item.desc}</Text>
          </Box>
        </Box>
      ))}

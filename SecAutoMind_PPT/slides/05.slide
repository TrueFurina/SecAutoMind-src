<Slide style={{ width: '1280px', height: '720px', position: 'relative', padding: 0, background: '#0B1120', color: '#F1F5F9', fontFamily: '思源黑体, sans-serif' }}>
  <Image src="assets/cover_hero.png" style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', objectFit: 'cover', opacity: 0.18 }} />
  <Box style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', background: 'rgba(11,17,32,0.88)' }} />
  <Box style={{ position: 'relative', zIndex: 1, width: '100%', height: '100%', padding: 40, flexDirection: 'column' }}>
    <Box style={{ height: 80, justifyContent: 'center' }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0EA5E9' }}>SecAutoMind 总体方案：一句话讲清我们在做什么</Text>
    </Box>
    <Box style={{ height: 540, flexDirection: 'row', gap: 36 }}>
      <Box style={{ width: '38%', flexDirection: 'column', justifyContent: 'center', gap: 12 }}>
        <Text style={{ fontSize: 26, fontWeight: 700, color: '#F1F5F9', lineHeight: 1.45 }}>“面向授权靶场与攻防演练场景，用多智能体自主编排 + 百级工具库 + 人机协同，完成从意图输入到标准化报告的全流程闭环。”</Text>
        {[
          { num: '01', title: '分层多智能体', desc: 'Deep / Plan-Execute / Supervisor 三种编排，适配不同任务复杂度' },
          { num: '02', title: '通用工具生态', desc: '90 个 YAML 工具、18 个角色化 Agent、23 个技能，覆盖全攻防链路' },
          { num: '03', title: '国产模型 + 一键部署', desc: '默认 qwen3-max，支持 DeepSeek，可部署在腾讯轻量云等标准 Linux 环境' },
        ].map((item, idx) => (
          <Box key={idx} style={{ flexDirection: 'row', gap: 14, padding: 10, background: 'rgba(14,165,233,0.10)', borderRadius: 12, borderLeft: '3px solid #0EA5E9' }}>
            <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#22D3EE', minWidth: 44 }}>{item.num}</Text>
            <Box>
              <Text style={{ fontSize: 20, fontWeight: 700, color: '#F1F5F9', marginBottom: 4 }}>{item.title}</Text>
              <Text style={{ fontSize: 17, color: '#94A3B8', lineHeight: 1.45 }}>{item.desc}</Text>
            </Box>
          </Box>
        ))}
      </Box>
      <Box style={{ flex: 1, justifyContent: 'center', alignItems: 'center' }}>
        <svg width={720} height={520} viewBox='0 0 720 520'>
          <defs>
            <linearGradient id='boxGrad' x1='0%' y1='0%' x2='0%' y2='100%'>
              <stop offset='0%' stopColor='rgba(59,130,246,0.35)' />
              <stop offset='100%' stopColor='rgba(14,165,233,0.12)' />
            </linearGradient>
            <marker id='arrow' markerWidth='10' markerHeight='10' refX='9' refY='3' orient='auto' markerUnits='strokeWidth'>
              <path d='M0,0 L0,6 L9,3 z' fill='#22D3EE' />
            </marker>
          </defs>
          <rect x={210} y={20} width={300} height={56} rx={10} fill='url(#boxGrad)' stroke='#0EA5E9' strokeWidth={2} />
          <text x={360} y={54} textAnchor='middle' fill='#F1F5F9' fontSize={19} fontWeight='bold' fontFamily='思源黑体, sans-serif'>Web 控制台</text>
          <line x1={360} y1={76} x2={360} y2={118} stroke='#22D3EE' strokeWidth={2} markerEnd='url(#arrow)' />

          <rect x={160} y={130} width={400} height={68} rx={10} fill='url(#boxGrad)' stroke='#22D3EE' strokeWidth={2} />
          <text x={360} y={155} textAnchor='middle' fill='#F1F5F9' fontSize={18} fontWeight='bold' fontFamily='思源黑体, sans-serif'>编排器</text>
          <text x={360} y={180} textAnchor='middle' fill='#94A3B8' fontSize={14} fontFamily='思源黑体, sans-serif'>Deep / Plan-Execute / Supervisor</text>

          <line x1={360} y1={198} x2={360} y2={240} stroke='#22D3EE' strokeWidth={2} markerEnd='url(#arrow)' />
          <line x1={360} y1={210} x2={180} y2={210} stroke='#22D3EE' strokeWidth={2} />
          <line x1={180} y1={210} x2={180} y2={260} stroke='#22D3EE' strokeWidth={2} markerEnd='url(#arrow)' />
          <line x1={360} y1={210} x2={540} y2={210} stroke='#22D3EE' strokeWidth={2} />
          <line x1={540} y1={210} x2={540} y2={260} stroke='#22D3EE' strokeWidth={2} markerEnd='url(#arrow)' />

          <rect x={70} y={270} width={160} height={56} rx={10} fill='url(#boxGrad)' stroke='#3B82F6' strokeWidth={2} />
          <text x={150} y={302} textAnchor='middle' fill='#F1F5F9' fontSize={17} fontWeight='bold' fontFamily='思源黑体, sans-serif'>规划 Agent</text>
          <rect x={260} y={270} width={200} height={56} rx={10} fill='url(#boxGrad)' stroke='#3B82F6' strokeWidth={2} />
          <text x={360} y={302} textAnchor='middle' fill='#F1F5F9' fontSize={17} fontWeight='bold' fontFamily='思源黑体, sans-serif'>执行 Agent 群</text>
          <rect x={490} y={270} width={160} height={56} rx={10} fill='url(#boxGrad)' stroke='#3B82F6' strokeWidth={2} />
          <text x={570} y={302} textAnchor='middle' fill='#F1F5F9' fontSize={17} fontWeight='bold' fontFamily='思源黑体, sans-serif'>审计 Agent</text>

          <line x1={150} y1={326} x2={150} y2={380} stroke='#22D3EE' strokeWidth={2} />
          <line x1={360} y1={326} x2={360} y2={380} stroke='#22D3EE' strokeWidth={2} />
          <line x1={570} y1={326} x2={570} y2={380} stroke='#22D3EE' strokeWidth={2} />
          <line x1={150} y1={380} x2={570} y2={380} stroke='#22D3EE' strokeWidth={2} />
          <line x1={360} y1={380} x2={360} y2={410} stroke='#22D3EE' strokeWidth={2} markerEnd='url(#arrow)' />

          <rect x={170} y={420} width={380} height={56} rx={10} fill='url(#boxGrad)' stroke='#0EA5E9' strokeWidth={2} />
          <text x={360} y={445} textAnchor='middle' fill='#F1F5F9' fontSize={18} fontWeight='bold' fontFamily='思源黑体, sans-serif'>工具库 + MCP 服务</text>
          <text x={360} y={465} textAnchor='middle' fill='#94A3B8' fontSize={13} fontFamily='思源黑体, sans-serif'>90 个 YAML 工具 · 2 类 MCP 服务</text>
        </svg>
      </Box>
    </Box>
  </Box>
</Slide>

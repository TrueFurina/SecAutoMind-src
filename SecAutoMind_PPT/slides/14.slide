<Slide style={{ width: '1280px', height: '720px', padding: 40, background: '#0B1120', color: '#F1F5F9', fontFamily: '思源黑体, sans-serif' }}>
  <Box style={{ height: 80, justifyContent: 'center' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0EA5E9' }}>腾讯轻量云部署：云上一键跑起来</Text>
  </Box>
  <Box style={{ height: 560, flexDirection: 'row', gap: 32 }}>
    <Box style={{ width: '46%', flexDirection: 'column', gap: 16, justifyContent: 'center' }}>
      <Box style={{ padding: 14, background: 'rgba(14,165,233,0.10)', borderRadius: 10, borderLeft: '3px solid #0EA5E9' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#F1F5F9', marginBottom: 6 }}>结论：可以部署，且适合。</Text>
        <Text style={{ fontSize: 16, color: '#94A3B8', lineHeight: 1.5 }}>轻量云是标准 Linux 主机，项目通过 run.sh 一键编译启动；关键在于 CGO、内存、暴露面、备案四个点。</Text>
      </Box>
      <Box style={{ flexDirection: 'column', gap: 10 }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#F1F5F9' }}>推荐规格与依赖</Text>
        {[
          { label: '配置', val: '4 核 8 G 起步（2 核 4 G 需加 Swap）' },
          { label: '系统', val: 'Ubuntu 22.04 / TencentOS，需安装 gcc（CGO）' },
          { label: '运行时', val: 'Go 1.25 + Python 3.10+ + nginx' },
          { label: '网络', val: '公网 IP，安全组仅开 22/80/443' },
        ].map((item, idx) => (
          <Box key={idx} style={{ flexDirection: 'row', gap: 10, padding: '8px 12px', background: 'rgba(59,130,246,0.08)', borderRadius: 6 }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#22D3EE', minWidth: 60 }}>{item.label}</Text>
            <Text style={{ fontSize: 15, color: '#94A3B8' }}>{item.val}</Text>
          </Box>
        ))}
      </Box>
      <Box style={{ flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#F1F5F9' }}>部署步骤</Text>
        {[
          '1. 购买轻量云，安装 Go/Python/gcc/git',
          '2. 上传项目，执行 ./run.sh 编译启动',
          '3. nginx 反向代理 + Let\'s Encrypt SSL',
          '4. 配置 config.yaml 为国内备案模型通道',
          '5. 安恒 AI 安全网关接入（终审要求）',
        ].map((item, idx) => (
          <Text key={idx} style={{ fontSize: 15, color: '#94A3B8', lineHeight: 1.4 }}>{item}</Text>
        ))}
      </Box>
    </Box>
    <Box style={{ flex: 1, justifyContent: 'center', alignItems: 'center' }}>
      <svg width={640} height={520} viewBox='0 0 640 520'>
        <defs>
          <linearGradient id='depGrad' x1='0%' y1='0%' x2='0%' y2='100%'>
            <stop offset='0%' stopColor='rgba(59,130,246,0.35)' />
            <stop offset='100%' stopColor='rgba(14,165,233,0.12)' />
          </linearGradient>
          <marker id='arrDep' markerWidth='10' markerHeight='10' refX='9' refY='3' orient='auto' markerUnits='strokeWidth'>
            <path d='M0,0 L0,6 L9,3 z' fill='#22D3EE' />
          </marker>
        </defs>
        <rect x={260} y={20} width={120} height={50} rx={8} fill='url(#depGrad)' stroke='#22D3EE' strokeWidth={2} />
        <text x={320} y={50} textAnchor='middle' fill='#F1F5F9' fontSize={15} fontWeight='bold' fontFamily='思源黑体, sans-serif'>用户</text>
        <line x1={320} y1={70} x2={320} y2={110} stroke='#22D3EE' strokeWidth={2} markerEnd='url(#arrDep)' />

        <rect x={200} y={120} width={240} height={60} rx={8} fill='url(#depGrad)' stroke='#0EA5E9' strokeWidth={2} />
        <text x={320} y={145} textAnchor='middle' fill='#F1F5F9' fontSize={15} fontWeight='bold' fontFamily='思源黑体, sans-serif'>腾讯轻量云 · 公网 IP</text>
        <text x={320} y={167} textAnchor='middle' fill='#94A3B8' fontSize={12} fontFamily='思源黑体, sans-serif'>安全组 80/443/22</text>
        <line x1={320} y1={180} x2={320} y2={220} stroke='#22D3EE' strokeWidth={2} markerEnd='url(#arrDep)' />

        <rect x={230} y={230} width={180} height={50} rx={8} fill='url(#depGrad)' stroke='#3B82F6' strokeWidth={2} />
        <text x={320} y={260} textAnchor='middle' fill='#F1F5F9' fontSize={15} fontWeight='bold' fontFamily='思源黑体, sans-serif'>nginx + SSL</text>
        <line x1={320} y1={280} x2={320} y2={320} stroke='#22D3EE' strokeWidth={2} markerEnd='url(#arrDep)' />

        <rect x={220} y={330} width={200} height={60} rx={8} fill='url(#depGrad)' stroke='#0EA5E9' strokeWidth={2} />
        <text x={320} y={355} textAnchor='middle' fill='#F1F5F9' fontSize={15} fontWeight='bold' fontFamily='思源黑体, sans-serif'>SecAutoMind</text>
        <text x={320} y={377} textAnchor='middle' fill='#94A3B8' fontSize={12} fontFamily='思源黑体, sans-serif'>Go + Python venv</text>

        <line x1={320} y1={390} x2={320} y2={430} stroke='#22D3EE' strokeWidth={2} markerEnd='url(#arrDep)' />
        <rect x={230} y={440} width={180} height={50} rx={8} fill='url(#depGrad)' stroke='#3B82F6' strokeWidth={2} />
        <text x={320} y={470} textAnchor='middle' fill='#F1F5F9' fontSize={15} fontWeight='bold' fontFamily='思源黑体, sans-serif'>SQLite / 文件</text>

        <rect x={500} y={340} width={120} height={50} rx={8} fill='url(#depGrad)' stroke='#22D3EE' strokeWidth={2} />
        <text x={560} y={370} textAnchor='middle' fill='#F1F5F9' fontSize={14} fontWeight='bold' fontFamily='思源黑体, sans-serif'>国产大模型</text>
        <line x1={420} y1={360} x2={500} y2={360} stroke='#22D3EE' strokeWidth={2} markerEnd='url(#arrDep)' />
      </svg>
    </Box>
  </Box>
  <Box style={{ height: 40, justifyContent: 'flex-end', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>14 / 15</Text>
  </Box>
</Slide>

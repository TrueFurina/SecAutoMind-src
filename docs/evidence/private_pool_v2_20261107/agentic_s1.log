          "code": "def rc4_ksa(key):\n    \"\"\"Key Scheduling Algorithm\"\"\"\n    S = list(range(256))\n    j = 0\n    for i in range(256):\n        j = (j + S[i] + key[i % len(key)]) % 256\n        S[i], S[j] = S[j], S[i]\n    return S\n\ndef rc4_prga(S, data_len):\n    \"\"\"Pseudo-Random Generation Algorithm\"\"\"\n    i = 0\n    j = 0\n    keystream = []\n    for _ in range(data_len):\n        i = (i + 1) % 256\n        j = (j + S[i]) % 256\n        S[i], S[j] = S[j], S[i]\n        keystream.append(S[(S[i] + S[j]) % 256])\n    return keystream\n\ndef rc4_decrypt(key, ciphertext):\n    S = rc4_ksa(key)\n    keystream = rc4_prga(S, len(ciphertext))\n    plaintext = bytes([c ^ k for c, k in zip(ciphertext, keystream)])\n    return plaintext\n\n# Key: 10624f1de4 (hex string representing 10 bytes)\nkey_hex = \"10624f1de4\"\nkey = bytes.fromhex(key_hex)\nprint(f\"Key ({len(key)} bytes): {key}\")\n\n# Ciphertext\nct_hex = \"3836e75b5f0a3687211895667eb8d728b99b82d70de7\"\nciphertext = bytes.fromhex(ct_hex)\nprint(f\"Ciphertext ({len(ciphertext)} bytes): {ciphertext.hex()}\")\n\n# Decrypt\nplaintext = rc4_decrypt(key, ciphertext)\nprint(f\"Plaintext (hex): {plaintext.hex()}\")\nprint(f\"Plaintext (ASCII): {plaintext}\")\nprint(f\"Plaintext (repr): {repr(plaintext)}\")\n",
